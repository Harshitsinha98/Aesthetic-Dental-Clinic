# Align Aesthetic Dental Hub — environment
# Copy to .env.local. Every value is optional: with an empty file the site runs,
# bookings go to a local SQLite file, WhatsApp messages are LOGGED to the admin
# outbox instead of sent, the assistant uses its built-in answers, and the
# reviews section shows links to Google.

NEXT_PUBLIC_SITE_URL=https://alignaesthetic.in

# ── Front desk (/admin) — at least 6 characters ───────────────────
ADMIN_PASSCODE=

# ── Database ──────────────────────────────────────────────────────
# Vercel/serverless: REQUIRED. Create a free database at https://turso.tech
# (or run `npm run setup:turso`) and paste both values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local / VPS alternative (used when TURSO_DATABASE_URL is empty):
DATABASE_PATH=./data/align-aesthetic.db

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Where "new booking" alerts go. Currently the owner's test number.
DOCTOR_WHATSAPP_NUMBER=919653043939
# Approved template names (see README). Leave empty to send plain text,
# which Meta only delivers inside a 24-hour customer-service window.
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_PATIENT_BOOKED=
WHATSAPP_TEMPLATE_DOCTOR_BOOKED=
WHATSAPP_TEMPLATE_PATIENT_CANCELLED=
WHATSAPP_TEMPLATE_DOCTOR_CANCELLED=

# ── Google reviews (Places API "New") ─────────────────────────────
GOOGLE_PLACES_API_KEY=
# Optional; found automatically from the clinic name if empty.
GOOGLE_PLACE_ID=

# ── Align Assistant (set ONE; optional) ───────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=
OPENAI_BASE_URL=
